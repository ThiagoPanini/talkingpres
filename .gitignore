# Claude Code — local overrides (personal, not for the repo)
.claude/settings.local.json

# MCP: o `.mcp.json` do Claude Code é VERSIONADO, com placeholder de variável de
# ambiente no lugar do segredo (anatomia panlabs, item `app-mcp-config-versioned`).
# O config real gitignorado com o token literal dentro nunca era de fato
# compartilhado, apesar do nome. O do Copilot continua local por ora.
.vscode/mcp.json

# Codex: o diretório inteiro fica fora do git. O template versionado saiu (era
# configuração de ferramenta fora da toolchain decidida, e duplicava exatamente
# os três servidores do `.mcp.json`); a linha continua aqui porque o config real
# que alguém gere localmente carrega token literal dentro.
.codex/

